# Bu dosyayı repo köküne .env olarak kopyala (snow/.env)
# Kişisel lab varsayılanları — push öncesi secret temizle

SNOW_APP_TOKEN=buraya-uzun-rastgele-token
OPENROUTER_API_KEY=sk-or-v1-...
HA_URL=http://192.168.1.13:8123
HA_TOKEN=ha-long-lived-token
HA_DEFAULT_LIGHT=light.bulb
HA_DEFAULT_TV=media_player.arcelik_android_tv

# Konum (hava)
HOME_LAT=41.0082
HOME_LON=28.9784

ENABLE_RULE_FALLBACK=true
RATE_LIMIT_PER_MINUTE=60

# MSI PC agent (same token on MSI pc-agent process)
# SNOW_PC_AGENT_TOKEN=uzun-ortak-gizli-acer-ve-msi
# PCS_FILE is optional; default personal/pcs.yaml
